{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["github>swissgeo/.github:renovate-preset"],
    "reviewers": ["keetraxx", "romankaravia"],
    "baseBranchPatterns": ["develop"],
    "lockFileMaintenance": {
        "enabled": true
    },
    "packageRules": [
        {
            "description": "Do not update the packageManager field in package.json files",
            "matchDepTypes": ["packageManager"],
            "enabled": false
        },
        {
            "description": "Update typescript major updates manually",
            "matchPackageNames": ["typescript"],
            "matchUpdateTypes": ["major"],
            "enabled": false
        },
        {
            "description": "Update prettier manually, prettier introduces breaking changes in minor updates",
            "matchPackageNames": ["prettier"],
            "matchUpdateTypes": ["major", "minor"],
            "enabled": false
        }
    ],
    "postUpgradeTasks": {
        "commands": ["pnpm install --lockfile-only"],
        "fileFilters": ["pnpm-lock.yaml"],
        "executionMode": "branch"
    }
}
